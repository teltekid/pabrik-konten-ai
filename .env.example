# Salin menjadi .env untuk dev lokal (JANGAN commit .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Management token (untuk migrasi skema via scripts)
SUPABASE_ACCESS_TOKEN=
# Project ref (dashboard Supabase > Project Settings > General > Reference ID)
SUPABASE_PROJECT_REF=

# Better Auth (Postgres)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8888

# LLM providers (worker)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Workers AI (generate gambar postingan, free tier 10k neurons/hari)
# Account ID: dashboard Cloudflare > Workers & Pages > Account ID (kanan bawah)
# API Token: My Profile > API Tokens > Create Token > template "Workers AI"
CLOUDFLARE_IMAGE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hanya untuk Netlify Function (server) - set di dashboard Netlify
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_PAT=

# Telegram review (opsional, per-workspace juga bisa diisi via UI)
TELEGRAM_WEBHOOK_SECRET=

# Auto-post scheduler
CRON_SECRET=
ALLOW_UNAUTH_CRON=false

# Instagram Graph API (real publish)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# URL publik untuk set webhook Telegram (opsional; default pakai origin request)
PUBLIC_URL=